# Copy this file to .env and edit for your machine.
# Linux Arduino usually /dev/ttyACM0 or /dev/ttyUSB0 | Windows usually COM3/COM4

# --- Hardware ---
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=9600
SIGNAL_RED_PIN_HINT=8

# --- Camera: 0 = webcam | path.mp4 = recorded video | http://... = phone IP stream ---
VIDEO_SOURCE=0

# --- App ---
DATABASE_PATH=data/rto.db
EVIDENCE_DIR=evidence/images
FLASK_PORT=5000
LOCATION=College Demo Junction

# --- Demo mode: 1 = simulate Arduino+AI events (clearly labelled), 0 = real hardware ---
DEMO_MODE=1
